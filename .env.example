# ============================================================================
# Arena do Vôlei — variáveis de ambiente
# Copie para .env.local (não versionado) e ajuste conforme o ambiente.
# ============================================================================

# Banco de dados -----------------------------------------------------------------
# Desenvolvimento local: `pnpm dev` inicia automaticamente um PostgreSQL 18
# embarcado (embedded-postgres) na porta 54364 e cria o banco "arena".
# A URL abaixo já funciona com esse servidor local.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54364/arena

# Produção (Supabase): use a connection string do pooler (porta 6543).
# postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Para rodar migrações, prefira a conexão direta (porta 5432) em .env.production.local:
# DATABASE_URL_UNPOOLED=postgresql://postgres:<senha>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# Depois rode: yarn db:setup:prod
#
# Neon: use a URL com "-pooler" no app e a URL direta para migrações.
# As imagens (avatar, logo e capa) ficam no próprio Postgres, então contam no limite de banco.

# URL pública do site (usada em links de e-mail e metadados) ---------------------
APP_URL=http://localhost:3000

# E-mail / recuperação de senha --------------------------------------------------
# Sem provedor configurado, os e-mails são gravados em .data/outbox (modo dev).
# Resend (recomendado em produção):
RESEND_API_KEY=
EMAIL_FROM="Arena do Vôlei <nao-responda@seudominio.com>"

# Alternativa via SMTP:
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Opcional: diretório alternativo dos e-mails de desenvolvimento
OUTBOX_DIR=

# Cron de expiração das pré-inscrições
CRON_SECRET=

# Opcional: fixa um e-mail como administrador no cadastro.
# O primeiro usuário cadastrado já recebe permissão de administrador.
ADMIN_EMAIL=

# Testes E2E (opcional) ----------------------------------------------------------
# Se definido, os testes E2E usam este banco em vez do Postgres embarcado isolado.
E2E_DATABASE_URL=

