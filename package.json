{
    "name": "nucleo-fc",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "tsx scripts/dev.ts",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx scripts/migrate.ts",
        "db:seed": "tsx scripts/seed.ts",
        "db:setup": "yarn db:migrate && yarn db:seed",
        "db:setup:prod": "tsx scripts/setup-prod.ts",
        "test": "tsx scripts/test.ts",
        "test:e2e": "playwright test",
        "db:demo": "tsx scripts/demo.ts",
        "db:reset": "tsx scripts/reset.ts && yarn db:seed",
        "dev:e2e": "tsx scripts/dev.ts --e2e",
        "dev:next": "next dev",
        "test:watch": "tsx scripts/test.ts --watch"
    },
    "dependencies": {
        "@date-fns/tz": "^1.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.4",
        "lucide-react": "^1.61.0",
        "next": "16.4.3",
        "nodemailer": "^10.2.1",
        "postgres": "^3.4.9",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "sharp": "^0.35.5",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/turbopack": "^4",
        "@types/node": "^20",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "^18.0.9",
        "drizzle-kit": "^0.31.11",
        "embedded-postgres": "18.4.0-beta.17",
        "eslint": "^9",
        "eslint-config-next": "16.4.3",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vite": "^7",
        "vitest": "^5.0.5"
    },
    "packageManager": "yarn@1.22.22",
    "engines": {
        "node": ">=20.9.0"
    }
}
